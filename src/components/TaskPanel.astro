---
import { render } from 'astro:content';

interface Props {
  task: any;
  answer?: any;
  active?: boolean;
}

const { task, answer, active = false } = Astro.props;
const TaskContent = (await render(task)).Content;
const AnswerContent = answer ? (await render(answer)).Content : null;
const base = import.meta.env.BASE_URL;
const href = (path: string) => base.replace(/\/$/, '') + path;
---

<article class:list={['mb-task-detail', { 'is-active': active }]} data-task-detail={task.data.lesson}>
  <div class="mb-task-detail-head">
    <span class="mb-kicker">Задача {String(task.data.number).padStart(2, '0')} · Часть {task.data.part}</span>
    <h2>{task.data.title}</h2>
    <p>{task.data.description}</p>
  </div>

  <div class="mb-task-body">
    <TaskContent />
  </div>

  {AnswerContent && (
    <details class="mb-answer">
      <summary>
        <span>Показать решение</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="mb-answer-body"><AnswerContent /></div>
    </details>
  )}

  <a class="mb-task-all" href={href(`/zig/lessons/${task.data.lesson}/`)}>Открыть урок {task.data.number} →</a>
</article>
