---
const base = import.meta.env.BASE_URL;
const href = (path: string) => base.replace(/\/$/, '') + path;
---

<div class="mb-site-footer">
  <div class="mb-site-footer-inner">
    <a class="mb-brand mb-brand--footer" href={href('/')}>
      <span class="mb-logo" aria-hidden="true">m</span>
      <span class="mb-wordmark">movtobase</span>
    </a>
    <p>База знаний по системному программированию</p>
    <nav aria-label="Ссылки в подвале">
      <a href="https://github.com/larkliy" rel="noreferrer" target="_blank">GitHub</a>
      <span>© 2026</span>
    </nav>
  </div>
</div>
