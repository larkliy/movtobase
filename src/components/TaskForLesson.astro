---
import { getCollection, render } from 'astro:content';

interface Props {
  lesson: string;
}

const { lesson } = Astro.props;
const tasks = await getCollection('tasks');
const answers = await getCollection('answers');
const task = tasks.find((item) => item.data.lesson === lesson);
const answer = answers.find((item) => item.data.lesson === lesson);
const TaskContent = task ? (await render(task)).Content : undefined;
const AnswerContent = answer ? (await render(answer)).Content : undefined;
const base = import.meta.env.BASE_URL;
const href = (path: string) => base.replace(/\/$/, '') + path;
---

{task && (
  <section class="mb-task" id="task">
    <div class="mb-task-head">
      <span class="mb-kicker">Задача {task.data.number}</span>
      <h2>{task.data.title}</h2>
      <p>{task.data.description}</p>
    </div>

    <div class="mb-task-body">
      {TaskContent && <TaskContent />}
    </div>

    {answer && AnswerContent && (
      <details class="mb-answer" id="answer">
        <summary>
          <span>Показать решение</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="mb-answer-body">
          <AnswerContent />
        </div>
      </details>
    )}

    <a class="mb-task-all" href={href('/practice/')}>Все задачи и прогресс →</a>
  </section>
)}
