---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { zigLessons, zigParts, zigTotal } from '../../data/courses';

const base = import.meta.env.BASE_URL;
const href = (path: string) => base.replace(/\/$/, '') + path;
const first = zigLessons[0];
const lessonData = zigLessons.map((lesson) => ({
  slug: lesson.slug,
  number: lesson.number,
  part: lesson.part,
  title: `${lesson.number}. ${lesson.title}`,
  href: href(`/zig/lessons/${lesson.slug}/`),
}));

const checkpoints = [
  { title: 'Базовый синтаксис', note: 'Задачи 1–8', part: 1 },
  { title: 'Работа с памятью', note: 'Задачи 9–16', part: 2 },
  { title: 'Собственный аллокатор', note: 'Задачи 17–24', part: 3 },
  { title: 'Финальный CLI-проект', note: 'Capstone', part: 3 },
];
---

<StarlightPage
  frontmatter={{
    title: 'Zig 0.17.0 с нуля',
    description: '24 урока по Zig 0.17.0: от hello world до своего аллокатора и CLI-проекта. Задачи и решения.',
    template: 'splash',
  }}
  hasSidebar={false}
>
  <style is:global>
    main > .content-panel:first-child { display: none; }
    main { --sl-content-width: 74rem; }
  </style>

  <div class="mb-course-page">
    <nav class="mb-breadcrumbs" aria-label="Хлебные крошки">
      <a href={href('/')}>Главная</a><span>/</span><a href={href('/#courses')}>Курсы</a><span>/</span><span>Zig</span>
    </nav>

    <section class="mb-course-hero">
      <div>
        <span class="mb-pill">Курс · Zig 0.17.0</span>
        <h1>Zig 0.17.0 с нуля</h1>
        <p>24 урока: от hello world до своего аллокатора и CLI-проекта. Все примеры сверены с реальным компилятором.</p>
        <div class="mb-meta-chips">
          <span>24 урока</span><span>3 части</span><span>Задачи + решения</span><span>Zig 0.17.0</span>
        </div>
        <div class="mb-hero-actions">
          <a class="mb-btn mb-btn--primary" data-continue-href href={href(`/zig/lessons/${first.slug}/`)}><span data-continue-label>Продолжить урок 1</span> <span>→</span></a>
          <a class="mb-btn" href="#program">Программа</a>
        </div>
      </div>

      <aside class="mb-progress-card">
        <div class="mb-ring-wrap" data-progress-ring>
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <circle class="mb-ring-track" cx="60" cy="60" r="52"></circle>
            <circle class="mb-ring-value" data-ring-value cx="60" cy="60" r="52"></circle>
          </svg>
          <span data-progress-ring-label>0 / {zigTotal}</span>
        </div>
        <div class="mb-progress-copy">
          <strong data-progress-percent>Вы прошли 0%</strong>
          <p>Следующая контрольная точка — часть I</p>
          <ul class="mb-part-list">
            {zigParts.map((part) => (
              <li>
                <span class="mb-part-check" data-part-check={part.number}>✓</span>
                {part.title} <em data-part-count={part.number}>0/{part.lessons.length}</em>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </section>

    <section class="mb-course-body" id="program">
      <div class="mb-curriculum">
        {zigParts.map((part, index) => (
          <details class="mb-part" open={index < 2}>
            <summary>
              <span class="mb-part-title">{part.title}</span>
              <span class="mb-part-count">{part.lessons.length} уроков</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="mb-lesson-list">
              {part.lessons.map((lesson) => (
                <a class="mb-lesson-row" href={href(`/zig/lessons/${lesson.slug}/`)} data-lesson-row data-lesson-slug={lesson.slug}>
                  <span class="mb-status" aria-hidden="true">
                    <svg class="mb-status-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                    <span class="mb-status-dot"></span>
                  </span>
                  <span class="mb-lesson-number">{String(lesson.number).padStart(2, '0')}</span>
                  <span class="mb-lesson-copy">
                    <strong>{lesson.title}</strong>
                    <span>{lesson.duration} мин</span>
                  </span>
                  <span class="mb-chip">Задача</span>
                  <span class="mb-chip">Ответ</span>
                  <span class="mb-row-arrow">→</span>
                </a>
              ))}
            </div>
          </details>
        ))}

        <a class="mb-continue-cta" data-continue-href href={href(`/zig/lessons/${first.slug}/`)}>
          <span data-continue-cta-label>Продолжить с урока 1: {first.title}</span> <span>→</span>
        </a>
      </div>

      <aside class="mb-course-rail">
        <div class="mb-rail-card">
          <span class="mb-kicker">Контрольные точки</span>
          <ul class="mb-checkpoints">
            {checkpoints.map((item) => (
              <li><span class="mb-check">✓</span><span><strong>{item.title}</strong><em>{item.note}</em></span></li>
            ))}
          </ul>
        </div>

        <a class="mb-rail-card mb-rail-link" href={href('/zig/cheatsheet/')}>
          <span class="mb-kicker">Шпаргалка</span>
          <strong>Cheat sheet</strong>
          <span>Синтаксис, типы, std</span>
          <em>Открыть →</em>
        </a>

        <a class="mb-rail-card mb-rail-link" href={href('/zig/setup/')}>
          <span class="mb-kicker">Установка Zig</span>
          <strong>Настроить окружение</strong>
          <code>brew install zig</code>
          <em>Инструкция →</em>
        </a>
      </aside>
    </section>
  </div>

  <script type="application/json" id="mb-lessons-data" set:html={JSON.stringify(lessonData)}></script>
</StarlightPage>
