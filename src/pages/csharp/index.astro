---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { csharpArticles } from '../../data/courses';

const base = import.meta.env.BASE_URL;
const href = (path: string) => base.replace(/\/$/, '') + path;
const first = csharpArticles[0];
---

<StarlightPage
  frontmatter={{
    title: 'C# Low Level + Zero Allocations',
    description: 'Шесть глубоких разборов о том, как .NET работает под капотом: GC, Span, Unsafe, NativeAOT, TCP без аллокаций, Pipelines.',
    template: 'splash',
  }}
  hasSidebar={false}
>
  <style is:global>
    main > .content-panel:first-child { display: none; }
    main { --sl-content-width: 74rem; }
  </style>

  <div class="mb-csharp-page">
    <nav class="mb-breadcrumbs" aria-label="Хлебные крошки">
      <a href={href('/')}>Главная</a><span>/</span><a href={href('/#courses')}>Курсы</a><span>/</span><span>C#</span>
    </nav>

    <section class="mb-csharp-hero">
      <div class="mb-csharp-hero-copy">
        <span class="mb-pill">Серия разборов · .NET 9</span>
        <h1>C# Low Level<br />+ Zero Allocations</h1>
        <p>Шесть глубоких разборов о том, как .NET работает под капотом: от GC и Span до NativeAOT и TCP-сервера без аллокаций.</p>
        <div class="mb-meta-chips">
          <span>6 разборов</span><span>12 000 слов</span><span>CoreCLR</span><span>Практика</span>
        </div>
        <div class="mb-hero-actions">
          <a class="mb-btn mb-btn--primary" href={href(`/csharp/${first.slug}/`)}>Начать с первого разбора <span>→</span></a>
          <a class="mb-btn" href="#series">Все разборы</a>
        </div>
      </div>
      <div class="mb-csharp-art" aria-hidden="true">
        <div class="mb-art-stack"><span>Gen 0</span><span>Gen 1</span><span>Gen 2</span></div>
        <div class="mb-art-note">GC heap</div>
      </div>
    </section>

    <section class="mb-series-section" id="series">
      <div class="mb-section-head">
        <div>
          <span class="mb-kicker">Программа серии</span>
          <h2>От GC до zero-allocation сервера</h2>
        </div>
      </div>

      <div class="mb-series-list">
        {csharpArticles.map((article) => (
          <a class="mb-series-row" href={href(`/csharp/${article.slug}/`)}>
            <span class="mb-series-number">{String(article.number).padStart(2, '0')}</span>
            <span class="mb-series-copy">
              <strong>{article.title}</strong>
              <span>{article.description}</span>
              <span class="mb-tags">
                {article.tags.map((tag) => <span>{tag}</span>)}
              </span>
            </span>
            <span class="mb-series-meta">{article.duration} мин <span>→</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="mb-csharp-note">
      <span class="mb-kicker">Как читать</span>
      <h2>Не про синтаксис, а про то, что под ним</h2>
      <p>Каждый разбор идёт от исходников CoreCLR: сначала смотрим, как устроено внутри, потом — как этим пользоваться в горячем пути. Код на C#, но применим к любому .NET-проекту.</p>
      <div class="mb-how-grid">
        <div><span class="mb-how-icon">01</span><h3>Исходники</h3><p>Ссылки на конкретные файлы CoreCLR и runtime.</p></div>
        <div><span class="mb-how-icon">02</span><h3>Замеры</h3><p>Аллокации, latency и поведение GC до и после.</p></div>
        <div><span class="mb-how-icon">03</span><h3>Практика</h3><p>Код, который можно собрать и прогнать самому.</p></div>
      </div>
    </section>
  </div>
</StarlightPage>
